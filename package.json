{
  "name": "optchat-durable",
  "version": "0.4.1",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts serve --demo",
    "start": "node dist/cli.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test test/core/*.test.ts test/pi/*.test.ts",
    "check": "npm run check:format && npm run check:docs && npm run typecheck && npm test",
    "check:local": "npm run check && npm run check:package && npm run check:pi && npm run check:upgrade",
    "check:package": "node scripts/verify-package.mjs",
    "check:pi": "node scripts/verify-pi-package.mjs",
    "check:upgrade": "node scripts/verify-upgrade.mjs",
    "prepublishOnly": "npm run check && npm run check:package && npm run check:pi && npm run check:upgrade",
    "format": "prettier . --write",
    "check:format": "prettier . --check",
    "check:docs": "node scripts/check-docs.mjs",
    "eval:dry": "node --import tsx eval/run.ts",
    "eval:live": "node --import tsx eval/run.ts --live",
    "eval:storage": "node --import tsx eval/storage.ts",
    "eval:cache:dry": "node --import tsx eval/cache/run.ts",
    "eval:cache:live": "node --import tsx eval/cache/run.ts --live",
    "eval:pi": "node --import tsx eval/pi/run.ts",
    "check:pi-auth": "node --import tsx eval/pi/auth-check.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "22.18.6",
    "github-slugger": "2.0.0",
    "marked": "18.1.0",
    "prettier": "3.9.9",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0"
  },
  "description": "OptChat hierarchical memory for Pi: installable coding-agent package, native Pi Durable SDK, standalone UI and CLI.",
  "license": "MIT",
  "author": "Kevin Saltarelli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinqz/optchat-durable.git"
  },
  "homepage": "https://github.com/kevinqz/optchat-durable#readme",
  "bugs": {
    "url": "https://github.com/kevinqz/optchat-durable/issues"
  },
  "keywords": [
    "optchat",
    "pi-durable",
    "agent-memory",
    "durable-agents",
    "chat",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ]
  },
  "bin": {
    "optchat-durable": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "pi/",
    "web/",
    "docs/",
    "examples/",
    "eval/",
    ".env.example",
    "README.pt-BR.md",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CREDITS.md",
    "CITATION.cff",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
