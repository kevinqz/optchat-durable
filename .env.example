# Standalone CLI only. The Pi package uses Pi's /login, /model and --optchat-* flags.
# Copy to .env in the directory where you run the standalone command.
# Existing environment variables take precedence. Keep .env and history private.
OPTCHAT_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Defaults from the pinned Pi AI catalog; actual access depends on your account.
# OPTCHAT_MODEL=gpt-6-sol
# OPTCHAT_COMPACTOR_PROVIDER=openai
# OPTCHAT_COMPACTOR_MODEL=gpt-6-luna
# Anthropic defaults: claude-opus-4-8 and claude-haiku-4-5.

OPTCHAT_PORT=4317
OPTCHAT_VIEW_BYTES=128000
OPTCHAT_COMPACTOR_JOBS=8
OPTCHAT_MAX_INPUT_BYTES=32000
OPTCHAT_MAX_OUTPUT_TOKENS=8192
# OPTCHAT_DATA_DIR=/absolute/private/path/optchat

# For simulated responses with real persistence: optchat-durable --demo
# Reference: docs/reference/configuration.md
