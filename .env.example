# Copy to .env in your working directory; fill only your chosen provider's key.
# Keep .env and .optchat/ private. API keys are never sent to the browser.
OPTCHAT_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# OpenAI padrão: gpt-6-sol para conversar; gpt-6-luna para compactar.
# Anthropic padrão: claude-opus-4-8 e claude-haiku-4-5.
# OPTCHAT_MODEL=gpt-6-sol
# OPTCHAT_COMPACTOR_PROVIDER=openai
# OPTCHAT_COMPACTOR_MODEL=gpt-6-luna

OPTCHAT_PORT=4317
OPTCHAT_VIEW_BYTES=128000
OPTCHAT_COMPACTOR_JOBS=8
OPTCHAT_MAX_INPUT_BYTES=32000
OPTCHAT_MAX_OUTPUT_TOKENS=8192
# OPTCHAT_DATA_DIR=/caminho/privado/optchat
# For a simulated demo, run optchat-durable --demo (or npm run demo from source).
